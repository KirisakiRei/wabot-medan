# ----------------------------------------------------------------------
# LLM SERVER (OpenAI-compatible) - otak percakapan Nanobot
# ----------------------------------------------------------------------
NANOBOT_LLM_BASE_URL=https://xxxxx.domain/v1
NANOBOT_LLM_API_KEY=ganti-dengan-api-key-router
NANOBOT_LLM_MODEL=ganti-dengan-nama-model-di-router

NANOBOT_LLM_TEMPERATURE=0.2
NANOBOT_LLM_MAX_TOKENS=1024
NANOBOT_LLM_TIMEOUT=120

# ----------------------------------------------------------------------
# KONEKSI BACKEND (Business Brain) - REST API v1 NestJS
# ----------------------------------------------------------------------
# Base URL backend (lihat PORT pada .env backend)
NANOBOT_BACKEND_URL=http://localhost:8001
NANOBOT_SERVICE_TOKEN=ganti-dengan-token-kuat
NANOBOT_BACKEND_TIMEOUT=30

# ----------------------------------------------------------------------
# RUNTIME ENGINE
# ----------------------------------------------------------------------
NANOBOT_PORT=8765
# NANOBOT_WORKSPACE=./workspace
NANOBOT_HISTORY_LIMIT=20
NANOBOT_LOG_LEVEL=INFO

# ----------------------------------------------------------------------
# COMPACT MEMORY (ringkasan percakapan jangka panjang)
# ----------------------------------------------------------------------
# Gap waktu (menit) tanpa aktivitas yang memicu ringkasan percakapan
NANOBOT_COMPACT_GAP_MINUTES=60
# Cooldown (jam) agar ringkasan tidak dibuat terlalu sering
NANOBOT_COMPACT_COOLDOWN_HOURS=6
# Jumlah pesan terakhir yang dipertahankan setelah ringkasan dibuat
NANOBOT_COMPACT_TRIM_KEEP=10

# ----------------------------------------------------------------------
# (Backend) KEBIJAKAN PREFLIGHT - berlaku di .env backend
# ----------------------------------------------------------------------
# NANOBOT_RATE_LIMIT_TURNS=60
# NANOBOT_MAX_MESSAGE_LENGTH=1500
# NANOBOT_MEMORY_TTL_DAYS=30
